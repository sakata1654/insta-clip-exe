{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insta Clip Studio",
  "version": "1.0.0",
  "identifier": "com.instaclip.studio",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Insta Clip Studio", "width": 1400, "height": 860, "minWidth": 1000, "minHeight": 640, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
